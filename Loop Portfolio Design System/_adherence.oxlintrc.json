{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/portfolio/**",
              "ui_kits/portfolio-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|DM Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, DM Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|status|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:available|busy|closed)$/]",
        "message": "<Badge> status must be one of 'available' | 'busy' | 'closed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Blob'] > JSXAttribute > JSXIdentifier[name!=/^(?:palette|size|blur|spin|opacity|style|key|ref|className|style|children)$/]",
        "message": "<Blob> doesn't accept that prop. Declared props: palette, size, blur, spin, opacity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Blob'] > JSXAttribute[name.name='palette'] > Literal[value!=/^(?:blue|mint|lilac|sunset)$/]",
        "message": "<Blob> palette must be one of 'blue' | 'mint' | 'lilac' | 'sunset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|variant|icon|iconPosition|disabled|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, variant, icon, iconPosition, disabled, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|paper|blue|mint|lilac|butter)$/]",
        "message": "<Button> tone must be one of 'ink' | 'paper' | 'blue' | 'mint' | 'lilac' | 'butter'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|outlined|shadow|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, outlined, shadow, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|sunken|blue|mint|lilac|blush|butter|ink)$/]",
        "message": "<Card> tone must be one of 'paper' | 'sunken' | 'blue' | 'mint' | 'lilac' | 'blush' | 'butter' | 'ink'."
      },
      {
